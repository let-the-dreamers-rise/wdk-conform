From 901d1d4ea783a9b43f12a529d23526905a544f68 Mon Sep 17 00:00:00 2001
From: wdk-conform <noreply@example.com>
Date: Tue, 20 Oct 2026 13:48:06 +0000
Subject: [PATCH] fix: default to the mainnet coin type when no network is
 configured

The address encoding falls back to mainnet when 'network' is omitted (as
documented), but the derivation path used coin type 1' in that case, so
default wallets showed mainnet addresses derived under m/84'/1' (or
m/44'/1'). Those seeds do not restore in other BIP-84/BIP-44 wallets.

Also reject unknown network names instead of silently using mainnet
encoding with the testnet coin type.

Found by wdk-conform.
---
 src/signers/seed-signer-btc.js        |  8 ++++-
 tests/signers/seed-signer-btc.test.js | 49 ++++++++++++++++++++-------
 tests/wallet-manager-btc.test.js      |  2 +-
 3 files changed, 45 insertions(+), 14 deletions(-)

diff --git a/src/signers/seed-signer-btc.js b/src/signers/seed-signer-btc.js
index 6add865..4492892 100644
--- a/src/signers/seed-signer-btc.js
+++ b/src/signers/seed-signer-btc.js
@@ -61,7 +61,13 @@ initEccLib(ecc)
  * @returns {string} The derivation path prefix (e.g. "84'/0'").
  */
 export function getBtcDerivationPathPrefix (config = {}) {
-  const { network, type = DEFAULT_ADDRESS_TYPE } = config
+  // The address encoding falls back to mainnet when no network is given, so the coin type must
+  // too: otherwise mainnet addresses are derived under the testnet coin type (1') and the seed
+  // does not restore in other BIP-44/BIP-84 wallets.
+  const { network = 'bitcoin', type = DEFAULT_ADDRESS_TYPE } = config
+  if (!networks[network]) {
+    throw new ValueError(`Unsupported network "${network}". Supported networks: bitcoin, testnet, regtest.`)
+  }
   return `${type === 'legacy' ? 44 : 84}'/${network === 'bitcoin' ? 0 : 1}'`
 }
 
diff --git a/tests/signers/seed-signer-btc.test.js b/tests/signers/seed-signer-btc.test.js
index ce3406d..6558476 100644
--- a/tests/signers/seed-signer-btc.test.js
+++ b/tests/signers/seed-signer-btc.test.js
